			<Item class="Script" referent="RBX102">
				<Properties>
					<bool name="Disabled">false</bool>
					<string name="Name">Leaderboard</string>
					<string name="Source">print(&quot;Leaderboard script loaded&quot;)&#13;&#10;&#13;&#10;&#13;&#10;function onPlayerEntered(newPlayer)&#13;&#10;&#13;&#10;&#13;&#10;&#9;local stats = Instance.new(&quot;IntValue&quot;)&#13;&#10;&#9;stats.Name = &quot;leaderstats&quot;&#13;&#10;&#13;&#10;&#9;local cash = Instance.new(&quot;IntValue&quot;)&#13;&#10;&#9;cash.Name = &quot;$ Test&quot;&#13;&#10;&#9;cash.Value = 0&#13;&#10;&#13;&#10;&#9;local kills = Instance.new(&quot;IntValue&quot;)&#13;&#10;&#9;kills.Name = &quot;Kills&quot;&#13;&#10;&#9;kills.Value = 0&#13;&#10;&#13;&#10;&#9;local deaths = Instance.new(&quot;IntValue&quot;)&#13;&#10;&#9;deaths.Name = &quot;Dies&quot;&#13;&#10;&#9;deaths.Value = 0&#13;&#10;&#13;&#10;&#9;kills.Parent = stats&#13;&#10;&#9;deaths.Parent = stats&#13;&#10;&#9;cash.Parent = stats&#13;&#10;&#13;&#10;&#9;local humanoid = newPlayer.Character.Humanoid&#13;&#10;&#9;humanoid.Died:connect(function() onHumanoidDied(humanoid, newPlayer) end )&#13;&#10;&#13;&#10;&#9;-- start to listen for new humanoid&#13;&#10;&#9;newPlayer.Changed:connect(function(property) onPlayerRespawn(property, newPlayer) end )&#13;&#10;&#13;&#10;&#13;&#10;&#9;stats.Parent = newPlayer&#13;&#10;&#13;&#10;end&#13;&#10;&#13;&#10;function income ()&#13;&#10;&#9;local cash = stats:findFirstChild(&quot;$&quot;)&#13;&#10;&#9;cash.Value = cash.Value + 1&#13;&#10;&#9;wait(0.8) &#13;&#10;end&#13;&#10;&#13;&#10;function onHumanoidDied(humanoid, player)&#13;&#10;&#9;local stats = player:findFirstChild(&quot;leaderstats&quot;)&#13;&#10;&#9;if stats ~= nil then&#13;&#10;&#9;&#9;local deaths = stats:findFirstChild(&quot;Deaths&quot;)&#13;&#10;&#9;&#9;deaths.Value = deaths.Value + 1&#13;&#10;&#9;&#9;handleKillCount(humanoid, player)&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function onPlayerRespawn(property, player)&#13;&#10;&#9;-- need to connect to new humanoid&#13;&#10;&#9;&#13;&#10;&#9;if property == &quot;Character&quot; then&#13;&#10;&#9;&#9;local humanoid = player.Character.Humanoid&#13;&#10;&#9;&#9;&#9;local p = player&#13;&#10;&#9;&#9;&#9;local h = humanoid&#13;&#10;&#9;&#9;&#9;humanoid.Died:connect(function() onHumanoidDied(h, p) end )&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;function handleKillCount(humanoid, player)&#13;&#10;&#9;-- todo, killing self results in negative points.&#13;&#10;&#9;&#13;&#10;&#9;-- check for kill tag on humanoid - may be more than one - todo: deal with this&#13;&#10;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)&#13;&#10;&#13;&#10;&#9;-- find player with name on tag&#13;&#10;&#9;if tag ~= nil then&#13;&#10;&#9;&#9;&#13;&#10;&#9;&#9;local killer = tag.Value&#13;&#10;&#9;&#9;if killer.Parent ~= nil then&#13;&#10;&#9;&#9;&#9;&#13;&#10;&#9;&#9;&#9;-- test if killer still in game, maybe not a big deal&#13;&#10;&#9;&#9;&#9;local stats = killer:findFirstChild(&quot;leaderstats&quot;)&#13;&#10;&#9;&#9;&#9;if stats ~= nil then&#13;&#10;&#9;&#9;&#9;&#9;local kills = stats:findFirstChild(&quot;Kills&quot;)&#13;&#10;&#9;&#9;&#9;&#9;if killer ~= player then&#13;&#10;&#9;&#9;&#9;&#9;&#9;kills.Value = kills.Value + 1&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#13;&#10;&#9;&#9;&#9;&#9;else&#13;&#10;&#9;&#9;&#9;&#9;&#9;kills.Value = kills.Value - 1&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end &#13;&#10;&#9;&#13;&#10;end&#13;&#10;&#13;&#10;game.Players.ChildAdded:connect(onPlayerEntered)</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX103">
				<Properties>
					<bool name="Disabled">false</bool>
					<string name="Name">Lighting</string>
					<string name="Source">while true do&#13;&#10;&#9;Lighting.TopAmbientV9 = (254,254,254)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (240,240,240)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (230,230,230)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (220,220,220)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (210,210,210)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (200,200,200)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (190,190,190)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (180,180,180)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (170,170,170)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (160,160,160)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (150,150,150)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (140,140,140)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (130,130,130)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (120,120,120)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (110,110,110)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (100,100,100)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (90,90,90)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (80,80,80)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (70,70,70)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (60,60,60)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (50,50,50)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (40,40,40)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (30,30,30)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (20,20,20)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (10,10,10)&#13;&#10;&#9;wait(5)&#13;&#10;&#9;Lighting.TopAmbientV9 = (0,0,0)&#13;&#10;end&#13;&#10;</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
