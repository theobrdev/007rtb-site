				<Item class="Script" referent="RBX3271">
					<Properties>
						<bool name="Disabled">true</bool>
						<string name="Name">MessageBox</string>
						<string name="Source">print(&quot;Mattcena's message box&quot;)&#13;&#10;&#13;&#10;local debounce = false&#13;&#10;&#13;&#10;&#13;&#10;function onHit(hit)&#13;&#10;&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if (human ~= nil) and debounce == false then&#13;&#10;&#13;&#10;                debounce = true&#13;&#10;&#13;&#10;local message = Instance.new(&quot;Message&quot;)&#13;&#10;message.Parent = game.Players:playerFromCharacter(hit.Parent)&#13;&#10;message.Text = &quot;Voiceless it cries,&quot;&#13;&#10;wait(5)&#13;&#10;message.Text = &quot;Wingless flutters,&quot;&#13;&#10;wait(5)&#13;&#10;message.Text = &quot;Toothless bites, &quot;&#13;&#10;wait(5)&#13;&#10;message.Text = &quot;Mouthless mutters.&quot;&#13;&#10;wait(5)&#13;&#10;message.Text = &quot;Speak your answer aloud to continue...&quot;&#13;&#10;wait(5)&#13;&#10;&#13;&#10;message:Remove ()&#13;&#10;&#13;&#10;                debounce = false&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;script.Parent.Touched:connect(onHit)&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX3272">
					<Properties>
						<bool name="Disabled">false</bool>
						<string name="Name">MessageBoxFilip</string>
						<string name="Source">print(&quot;Mattcena's message box, forked by filip&quot;)&#13;&#10;&#13;&#10;local debounce = false&#13;&#10;&#13;&#10;function onHit(hit)&#13;&#10;&#9;local human = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if (human ~= nil) and debounce == false then&#13;&#10;&#9;&#9;print(&quot;pinging&quot;)&#13;&#10;&#9;&#9;debounce = true&#13;&#10;&#13;&#10;&#9;&#9;local messageHolder = Instance.new(&quot;ScreenGui&quot;, game.Players:GetPlayerFromCharacter(hit.Parent).PlayerGui)&#13;&#10;&#9;&#9;local message = Instance.new(&quot;TextLabel&quot;, messageHolder)&#13;&#10;&#9;&#9;task.wait(1)&#13;&#10;&#9;&#9;message.Size = UDim2.new(0, 1800,0, 800)&#13;&#10;&#9;&#9;message.Position = UDim2.new(0.01, 0,0.01, 0)&#13;&#10;&#9;&#9;message.TextScaled = true&#13;&#10;&#13;&#10;&#9;&#9;message.Text = &quot;Sorry for the big screen blocking text. My time to set this up was very limited and I am not very good at making GUI with scripts. Onto the fun facts...&quot;&#13;&#10;&#9;&#9;wait(5)&#13;&#10;&#9;&#9;message.Text = &quot;This is the original version of Yoricks Resting Place. The actual event version was modified by Shedletsky before launch to make it more fun and easier for younger players. I kind of sort of made it as difficult as I could for people who wanted a challenge. I didn't agree with John as the time but nowadays I see why he did it. My versionw as punishinggggg.&quot;&#13;&#10;&#9;&#9;wait(20)&#13;&#10;&#9;&#9;message.Text = &quot;When I made the place, I was just doing it because I didn't think there would be a halloween event in 2007. In 2006 there wasn't really one either, but shedletsky uploaded 'Haunted Mansion' around halloween of 2006, and back then a new offical map was like an event in and of itself.&quot;&#13;&#10;&#9;&#9;wait(20)&#13;&#10;&#9;&#9;message.Text = &quot;So I set about trying to make a fan version of his game. His was a brick battle but what I loved about it was all the secrets. I wanted mine to be more of a puzzle game because there weren't that many of those in 2007. It became offical when John joined me testing the game and thought it could make a cool template for an offical event.&quot;&#13;&#10;&#9;&#9;wait(20)&#13;&#10;&#9;&#9;message.Text = &quot;I think he saw it on a Thursday evening and he needed it by monday moring. I went about creating it as quickly as I could, with the simple tools we had back then. They even paid me. I don't remember how much, but I did the math when I was a kid and figured it would be something like twenty dollars an hour for my labor. Back then, especially to kid me, that was SO MUCH money!&quot;&#13;&#10;&#9;&#9;wait(20)&#13;&#10;&#9;&#9;message.Text = &quot;John or I, I'm not sure who asked him, also recruited my brother to create the prize for the game. The Riddling Skull. He had never made a 3D model before, but he did an amazing job with it. I even went back and looked at the original file and it almost didn't have any ngons! His work on that model is what inspired me to get into 3D modling and that set me up to be the creator I am today.&quot;&#13;&#10;&#9;&#9;wait(20)&#13;&#10;&#9;&#9;message.Text = &quot;So thats the story of the 2007 Halloween event. It is one of my favorite childhood memories. John will never know how grateful I am to him for letting me make the event. And I am grateful to all of you! Thanks for revisiting my work. Knowing someone is readng this makes all the effort worth it.&quot;&#13;&#10;&#9;&#9;wait(20)&#13;&#10;&#13;&#10;&#9;&#9;messageHolder:Destroy()&#13;&#10;&#13;&#10;&#9;&#9;debounce = false&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;script.Parent.Touched:connect(onHit)&#13;&#10;</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
