			<Item class="Script" referent="RBX103">
				<Properties>
					<bool name="Disabled">false</bool>
					<string name="Name">Regen</string>
					<string name="Source">model = game.Workspace.regenme&#13;&#10;messageText = &quot;Recalculating random math values.&quot;&#13;&#10;&#13;&#10;message = Instance.new(&quot;Message&quot;)&#13;&#10;message.Text = messageText&#13;&#10;backup = model:clone()&#13;&#10;&#13;&#10;while true do&#13;&#10;&#9;wait (100)&#13;&#10;&#13;&#10;&#9;message.Parent = game.Workspace&#13;&#10;&#9;model:remove()&#13;&#10;&#13;&#10;&#9;wait (5)&#13;&#10;&#13;&#10;&#9;model = backup:clone()&#13;&#10;&#9;model.Parent = game.Workspace&#13;&#10;&#9;model:makeJoints()&#13;&#10;&#9;message.Parent = nil&#13;&#10;end&#13;&#10;</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
