				<Item class="Script" referent="RBX3269">
					<Properties>
						<bool name="Disabled">false</bool>
						<string name="Name">MessageBoxFilip</string>
						<string name="Source">print(&quot;Mattcena's message box, forked by filip&quot;)&#13;&#10;&#13;&#10;local debounce = false&#13;&#10;&#13;&#10;function onHit(hit)&#13;&#10;&#9;local human = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if (human ~= nil) and debounce == false then&#13;&#10;&#9;&#9;print(&quot;pinging&quot;)&#13;&#10;&#9;&#9;debounce = true&#13;&#10;&#13;&#10;&#9;&#9;local messageHolder = Instance.new(&quot;ScreenGui&quot;, game.Players:GetPlayerFromCharacter(hit.Parent).PlayerGui)&#13;&#10;&#9;&#9;local message = Instance.new(&quot;TextLabel&quot;, messageHolder)&#13;&#10;&#9;&#9;task.wait(1)&#13;&#10;&#9;&#9;message.Size = UDim2.new(0, 200,0, 50)&#13;&#10;&#9;&#9;message.Position = UDim2.new(0.449, 0,0.474, 0)&#13;&#10;&#9;&#9;message.TextScaled = true&#13;&#10;&#13;&#10;&#9;&#9;message.Text = &quot;Back in 2007 this would award you the skull&quot;&#13;&#10;&#9;&#9;wait(5)&#13;&#10;&#9;&#9;message.Text = &quot;Obviously that doesn't happen anymore.&quot;&#13;&#10;&#9;&#9;wait(5)&#13;&#10;&#9;&#9;message.Text = &quot;But I appreciate you coming down here anyway!&quot;&#13;&#10;&#9;&#9;wait(5)&#13;&#10;&#9;&#9;message.Text = &quot;If you want some fun facts, stand infront of my avatar.&quot;&#13;&#10;&#9;&#9;wait(5)&#13;&#10;&#9;&#9;message.Text = &quot;Cheers!&quot;&#13;&#10;&#9;&#9;wait(5)&#13;&#10;&#13;&#10;&#9;&#9;messageHolder:Destroy()&#13;&#10;&#13;&#10;&#9;&#9;debounce = false&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;script.Parent.Touched:connect(onHit)&#13;&#10;</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
