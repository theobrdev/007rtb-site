							<string name="Source">print(&quot;Mattcena's message box&quot;)&#13;&#10;&#13;&#10;local debounce = false&#13;&#10;&#13;&#10;&#13;&#10;function onHit(hit)&#13;&#10;&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if (human ~= nil) and debounce == false then&#13;&#10;&#13;&#10;                debounce = true&#13;&#10;&#13;&#10;local message = Instance.new(&quot;Message&quot;)&#13;&#10;message.Parent = game.Players:playerFromCharacter(hit.Parent)&#13;&#10;message.Text = &quot;Ah, you've found my house...&quot;&#13;&#10;wait(5)&#13;&#10;message.Text = &quot;You've gotten this far, keep going...&quot;&#13;&#10;wait(5)&#13;&#10;message.Text = &quot;If you can...&quot;&#13;&#10;wait(5)&#13;&#10;message.Text = &quot;Beware... You have no time to relax,&quot;&#13;&#10;wait(5)&#13;&#10;message.Text = &quot;or do you...?&quot;&#13;&#10;wait(5)&#13;&#10;&#13;&#10;&#13;&#10;message:Remove ()&#13;&#10;&#13;&#10;                debounce = false&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;script.Parent.Touched:connect(onHit)</string>
