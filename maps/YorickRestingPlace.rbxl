					<Item class="Script" referent="RBX3089">
						<Properties>
							<bool name="Disabled">true</bool>
							<string name="Name">MessageBox</string>
							<string name="Source">print(&quot;Mattcena's message box&quot;)&#13;&#10;&#13;&#10;local debounce = false&#13;&#10;&#13;&#10;&#13;&#10;function onHit(hit)&#13;&#10;&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if (human ~= nil) and debounce == false then&#13;&#10;&#13;&#10;                debounce = true&#13;&#10;&#13;&#10;local message = Instance.new(&quot;Message&quot;)&#13;&#10;message.Parent = game.Players:playerFromCharacter(hit.Parent)&#13;&#10;message.Text = &quot;It cannot be seen, cannot be felt,&quot; &#13;&#10;wait(5)&#13;&#10;message.Text =  &quot;Cannot be heard, cannot be smelt.&quot;&#13;&#10;wait(5)&#13;&#10;message.Text = &quot;It lies behind stars and under hills, And empty holes it fills.&quot;&#13;&#10;wait(5)&#13;&#10;message.Text = &quot;It comes first and follows after, Ends life, kills laughter.&quot;&#13;&#10;wait(5)&#13;&#10;message.Text = &quot;Speak your answer aloud to continue...&quot;&#13;&#10;wait(5)&#13;&#10;&#13;&#10;message:Remove ()&#13;&#10;&#13;&#10;                debounce = false&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;script.Parent.Touched:connect(onHit)&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX3090">
						<Properties>
							<bool name="Disabled">false</bool>
							<string name="Name">MessageBoxFilip</string>
							<string name="Source">print(&quot;Mattcena's message box, forked by filip&quot;)&#13;&#10;&#13;&#10;local debounce = false&#13;&#10;&#13;&#10;function onHit(hit)&#13;&#10;&#9;local human = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if (human ~= nil) and debounce == false then&#13;&#10;&#9;&#9;print(&quot;pinging&quot;)&#13;&#10;&#9;&#9;debounce = true&#13;&#10;&#13;&#10;&#9;&#9;local messageHolder = Instance.new(&quot;ScreenGui&quot;, game.Players:GetPlayerFromCharacter(hit.Parent).PlayerGui)&#13;&#10;&#9;&#9;local message = Instance.new(&quot;TextLabel&quot;, messageHolder)&#13;&#10;&#9;&#9;task.wait(1)&#13;&#10;&#9;&#9;message.Size = UDim2.new(0, 200,0, 50)&#13;&#10;&#9;&#9;message.Position = UDim2.new(0.449, 0,0.474, 0)&#13;&#10;&#9;&#9;message.TextScaled = true&#13;&#10;&#13;&#10;&#9;&#9;message.Text = &quot;It cannot be seen, cannot be felt,&quot;&#13;&#10;&#9;&#9;wait(5)&#13;&#10;&#9;&#9;message.Text = &quot;Cannot be heard, cannot be smelt.&quot;&#13;&#10;&#9;&#9;wait(5)&#13;&#10;&#9;&#9;message.Text = &quot;It lies behind stars and under hills, And empty holes it fills.&quot;&#13;&#10;&#9;&#9;wait(5)&#13;&#10;&#9;&#9;message.Text = &quot;It comes first and follows after, Ends life, kills laughter.&quot;&#13;&#10;&#9;&#9;wait(5)&#13;&#10;&#9;&#9;message.Text = &quot;Speak your answer aloud to continue...&quot;&#13;&#10;&#9;&#9;wait(5)&#13;&#10;&#13;&#10;&#9;&#9;messageHolder:Destroy()&#13;&#10;&#13;&#10;&#9;&#9;debounce = false&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;script.Parent.Touched:connect(onHit)&#13;&#10;</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
