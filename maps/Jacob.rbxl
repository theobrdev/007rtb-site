							<string name="Source">while true do&#13;&#10;&#13;&#10;script.Parent.Color = Color3.new(math.random(), math.random(), math.random() )&#13;&#10;&#13;&#10;wait(0.5)&#13;&#10;&#13;&#10;end </string>
