				<Item class="Script" referent="RBX126">
					<Properties>
						<bool name="Disabled">false</bool>
						<string name="Name">WitchBrew</string>
						<string name="Source">r = game:service(&quot;RunService&quot;)&#13;&#10;&#13;&#10;print(&quot;Witch's Brew loaded&quot;)&#13;&#10;&#13;&#10;brew = script.Parent.Brew&#13;&#10;&#13;&#10;function doTheBrew(humanoid, player)&#13;&#10;&#9;player.Head.Size = Vector3.new(2,2,2)&#13;&#10;&#9;player.Head.BrickColor = BrickColor.random()&#13;&#10;end&#13;&#10;&#13;&#10;function makeMeGhostly(trans)&#13;&#10;&#9;local char = game.Players.LocalPlayer.Character&#13;&#10;&#13;&#10;&#9;char.Head.Transparency = trans&#13;&#10;&#9;char.Torso.Transparency = trans&#13;&#10;&#9;char:findFirstChild(&quot;Left Leg&quot;).Transparency = trans&#13;&#10;&#9;char:findFirstChild(&quot;Right Leg&quot;).Transparency = trans&#13;&#10;&#9;char:findFirstChild(&quot;Left Arm&quot;).Transparency = trans&#13;&#10;&#9;char:findFirstChild(&quot;Right Arm&quot;).Transparency = trans&#13;&#10;end&#13;&#10;&#13;&#10;function onTouch(touchedPart)&#13;&#10;&#9;print(&quot;touched&quot;)&#13;&#10;&#9;-- see if a character touched it&#13;&#10;&#9;local parent = touchedPart.Parent&#13;&#10;&#9;&#9;if parent~=nil then&#13;&#10;&#9;&#9;local humanoid = parent:findFirstChild(&quot;Humanoid&quot;, false);&#13;&#10;&#9;&#9;if humanoid ~= nil then&#13;&#10;&#9;&#9;&#9;doTheBrew(humanoid, parent)&#13;&#10;&#9;&#9;&#9;return&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;print(brew)&#13;&#10;&#13;&#10;brew.Touched:connect(onTouch)&#13;&#10;&#13;&#10;</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
